# =====================================================================
# 長野県公共施設ナビ — 環境変数テンプレート
# このファイル (.env.local.example) はコミット可。
# 実際の値は .env.local にコピーして使う（.gitignoreで除外済）。
# =====================================================================

# ---- Supabase（必須） ----
# Project Settings → API から取得
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# anon / public key（フロントエンドから使う・公開OK）
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# service_role key（バックエンド/スクレイパー用・絶対公開禁止）
# このキーは RLS をバイパスする = フロントに書いたら全データを誰でも書き換え可能になる
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# ---- Phase 2以降で使う（今は不要・空でOK） ----
# Google Maps API
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# スクレイパー用 User-Agent（取得時の自己申告）
# SCRAPER_USER_AGENT=NaganoSportsFinder/0.1 (+https://your-domain/about; contact@example.com)
