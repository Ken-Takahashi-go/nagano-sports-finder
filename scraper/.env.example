# =====================================================================
# scraper/.env.example
# 実値は .env (gitignore済) に書く
# =====================================================================

# Supabase 接続 (Stage 2 以降で使用)
SUPABASE_URL=https://your-project-ref.supabase.co
# ★scraperは書き込むので service_role キー必須 (絶対に公開禁止)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# スクレイパー識別情報 (User-Agentに明示)
SCRAPER_NAME=NaganoSportsFinder
SCRAPER_VERSION=0.1.0
SCRAPER_CONTACT=contact@example.com

# 取得対象 (Stage 1 ではこのままで OK)
MACHIKAGI_BASE_URL=https://city.nagano.nagano.machikagi-remote.jp

# 取得間隔(秒) — 自治体システム配慮で長めに
REQUEST_INTERVAL_SECONDS=15
